# Copy to .env and fill in. Never commit .env.

# Supabase (get from P2)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Python service (local or staging)
SERVICE_BASE_URL=http://localhost:8000

# Local path to the GGUF model for development (not in Git)
MODEL_PATH=

# Feature flags (true/false)
USE_REAL_AI=false
USE_REAL_SYNC=false
USE_REAL_TEMPLATES=false
WORD_EXPORT=false
