<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep the encrypted consent database off backups and phone-to-phone transfers
  (issue #83). Its key lives in the Android Keystore, which is never copied, so
  a restored database could not be opened (DatabaseKeyMissing). Unsynced
  consents must stay on this phone until they reach Supabase.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
